# Your Discord bot token (Get this from the Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Your MailerSend API token
MAILERSEND_API_KEY=your_mailersend_api_key_here

# CiviCRM, to link Discord users to their member record (the bot's API key can make that call only)
CIVICRM_URL=https://crm.pauseai.info
CIVICRM_API_KEY=your_civicrm_api_key_here

# Developer mode (set to true to test locally without affecting production servers)
DEVELOPER_MODE=false

# Secret token to authenticate incoming webhooks from CiviCRM
WEBHOOK_SECRET=your_webhook_secret_here

# Postgres connection string for member records, server snapshots and the message log
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Off-site database backups (used by the backup cron job, jobs/backup.py, and by
# jobs/fetch_backup.py, which downloads the latest dump to your machine).
# Set the four variables for each provider you want a copy at; leave a provider's out to skip it.
# Use different providers rather than two buckets at one, so one outage can't take out every copy.
# On your own machine, set these only to run jobs/fetch_backup.py, and use a separate read-only key
# (for B2: Read Only, limited to the bucket and the file name prefix backups/). The cron job's
# read/write key stays in Railway. See "Downloading the latest dump" in the README.

# Backblaze B2: the region is the part of the bucket's S3 endpoint after "s3.", e.g. eu-central-003
BACKUP_B2_REGION=
BACKUP_B2_BUCKET=
BACKUP_B2_KEY_ID=
BACKUP_B2_SECRET=

# Cloudflare R2: the account ID is on the R2 overview page; add .eu for an EU-jurisdiction bucket
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_KEY_ID=
BACKUP_R2_SECRET=

# AWS S3
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
