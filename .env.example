# Your Discord bot token (Get this from the Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Your MailerSend API token
MAILERSEND_API_KEY=your_mailersend_api_key_here

# CiviCRM, to link Discord users to their member record (the bot's API key can make that call only)
CIVICRM_URL=https://crm.pauseai.info
CIVICRM_API_KEY=your_civicrm_api_key_here
# The bot's Cloudflare Access service token, which the CRM API needs once it sits behind Cloudflare
# Access. Set both or neither; sent only when CIVICRM_URL is https://crm.pauseai.info
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Developer mode (set to true to test locally without affecting production servers)
DEVELOPER_MODE=false

# Secret token to authenticate incoming webhooks from CiviCRM
WEBHOOK_SECRET=your_webhook_secret_here

# Secret token for the onboarding dashboard to read /stats/discord (aggregate member counts).
# Use a different value from WEBHOOK_SECRET.
STATS_SECRET=your_stats_secret_here

# Postgres connection string for member records, server snapshots and the message log
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The moderators' log channel (#logs): message edits and deletions are posted there. Leave empty
# to post nothing (the message log is kept in Postgres either way).
MESSAGE_LOG_CHANNEL_ID=
# Comma-separated category and channel IDs never posted to the log channel: internal groups such as
# staff and national chapter leads. A channel or thread is left out if its own, its parent
# channel's or its category's ID is listed.
MESSAGE_LOG_IGNORE_IDS=
