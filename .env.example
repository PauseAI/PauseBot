# Your Discord bot token (Get this from the Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Your MailerSend API token
MAILERSEND_API_KEY=your_mailersend_api_key_here

# Your Airtable configuration (Optional)
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_airtable_token_here

# Developer mode (set to true to test locally without affecting production servers)
DEVELOPER_MODE=false

# Secret token to authenticate incoming webhooks from Airtable
WEBHOOK_SECRET=your_webhook_secret_here

# Postgres connection string for server snapshots and the message log (Optional)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Backblaze B2 for off-site database backups (only used by the backup cron job, jobs/backup.py)
B2_KEY_ID=your_b2_key_id_here
B2_APP_KEY=your_b2_application_key_here
B2_BUCKET_NAME=your_b2_bucket_name_here
